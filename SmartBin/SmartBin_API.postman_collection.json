            "description": "User submits a request to get a Smart Bin."
          },
          "event": [{ "listen": "test", "script": { "exec": ["pm.test('Status 200', () => pm.response.to.have.status(200));"] } }]
        },
        {
          "name": "Get All Bin Requests (Admin)",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{jwtToken}}" }],
            "url": { "raw": "{{baseUrl}}/api/BinRequest", "host": ["{{baseUrl}}"], "path": ["api","BinRequest"] },
            "description": "Admin gets all bin requests."

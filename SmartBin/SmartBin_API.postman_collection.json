            ],
            "url": { "raw": "{{baseUrl}}/api/BinSection/update", "host": ["{{baseUrl}}"], "path": ["api","BinSection","update"] },
            "body": { "mode": "raw", "raw": "{\n  \"materialName\": \"Plastic\",\n  \"levelPercentage\": 60.0,\n  \"weight\": 1.8\n}" },
            "description": "ESP device updates fill level and weight for a bin section."
          },
          "event": [{ "listen": "test", "script": { "exec": ["pm.test('Status 200 or 404', () => pm.expect(pm.response.code).to.be.oneOf([200,404]));"] } }]
        }
      ]
    },

    {
      "name": "4 - Bin Requests",
      "item": [
        {
          "name": "Submit Bin Request",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{jwtToken}}" },

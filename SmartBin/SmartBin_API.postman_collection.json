{
  "info": {
    "name": "SmartBin API",
    "_postman_id": "smartbin-api-collection-v2",
    "description": "Complete SmartBin API collection — covers Auth, Bins, Sections, Bin Requests, Cameras, Camera Requests, Transactions, Surrounding Waste, and Crowd Density.\n\nBase URL variable: {{baseUrl}}  (default: https://smartbinpsu.runasp.net)\nAuth token variable: {{jwtToken}}  (set automatically by the Login request)",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:5025", "type": "string" },
    { "key": "jwtToken", "value": "", "type": "string" },
    { "key": "binToken", "value": "f41e1f74-bba8-4012-94bc-f4d7a20031ed", "type": "string" },
    { "key": "cameraToken", "value": "ce309b7a-eb64-486e-9e35-82e052d06348", "type": "string" }
  ],
  "item": [

    {
      "name": "1 - Auth",
      "item": [
        {
          "name": "Register",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{baseUrl}}/api/Auth/register", "host": ["{{baseUrl}}"], "path": ["api","Auth","register"] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"user@example.com\",\n  \"password\": \"Aa12345678@\",\n  \"fullName\": \"Ahmed Mohamed\"\n}"
            },
            "description": "Register a new user. Returns a JWT token."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 200) {",
                  "  var json = pm.response.json();",
                  "  pm.collectionVariables.set('jwtToken', json.token);",
                  "  pm.test('Register succeeded', () => pm.response.to.have.status(200));",
                  "  pm.test('Token returned', () => pm.expect(json.token).to.be.a('string'));",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "Login",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{baseUrl}}/api/Auth/login", "host": ["{{baseUrl}}"], "path": ["api","Auth","login"] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"admin@gmail.com\",\n  \"password\": \"Aa12345678@\"\n}"
            },
            "description": "Login and retrieve JWT. Token is auto-saved to {{jwtToken}}."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Login succeeded', () => pm.response.to.have.status(200));",
                  "var json = pm.response.json();",
                  "pm.test('Token returned', () => pm.expect(json.token).to.be.a('string'));",
                  "pm.collectionVariables.set('jwtToken', json.token);"
                ]
              }
            }
          ]
        }
      ]
    },

    {
      "name": "2 - Bin (SmartBin)",
      "item": [
        {
          "name": "Create Bin (Admin)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Authorization", "value": "Bearer {{jwtToken}}" }],
            "url": { "raw": "{{baseUrl}}/api/SmartBin/Create", "host": ["{{baseUrl}}"], "path": ["api","SmartBin","Create"] },
            "description": "Admin creates an unassigned bin and gets its IdentificationToken."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "var token = pm.response.json();",
                  "pm.test('Token returned', () => pm.expect(token).to.be.a('string'));",
                  "pm.collectionVariables.set('binToken', token);"
                ]
              }
            }
          ]
        },
        {
          "name": "Assign Bin",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{jwtToken}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "url": { "raw": "{{baseUrl}}/api/SmartBin/Assign", "host": ["{{baseUrl}}"], "path": ["api","SmartBin","Assign"] },
            "body": { "mode": "raw", "raw": "{\n  \"token\": \"{{binToken}}\"\n}" },
            "description": "Assign a bin to the authenticated user."
          },
          "event": [{ "listen": "test", "script": { "exec": ["pm.test('Status 200', () => pm.response.to.have.status(200));"] } }]
        },
        {
          "name": "Get All Bins",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{jwtToken}}" }],
            "url": { "raw": "{{baseUrl}}/api/SmartBin", "host": ["{{baseUrl}}"], "path": ["api","SmartBin"] },
            "description": "Get all bins owned by the logged-in user."
          },
          "event": [{ "listen": "test", "script": { "exec": ["pm.test('Status 200', () => pm.response.to.have.status(200));", "pm.test('Array response', () => pm.expect(pm.response.json()).to.be.an('array'));"] } }]
        },
        {
          "name": "Get Bin by ID",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{jwtToken}}" }],
            "url": { "raw": "{{baseUrl}}/api/SmartBin/1", "host": ["{{baseUrl}}"], "path": ["api","SmartBin","1"] },
            "description": "Get a specific bin with its sections."
          },
          "event": [{ "listen": "test", "script": { "exec": ["pm.test('Status 200 or 404', () => pm.expect(pm.response.code).to.be.oneOf([200,404]));"] } }]
        },
        {
          "name": "Update Bin GPS (Device)",
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Token", "value": "{{binToken}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "url": { "raw": "{{baseUrl}}/api/SmartBin/Update", "host": ["{{baseUrl}}"], "path": ["api","SmartBin","Update"] },
            "body": { "mode": "raw", "raw": "{\n  \"latitude\": 30.0500,\n  \"longitude\": 31.2400\n}" },
            "description": "ESP device updates its GPS coordinates using the device token (no JWT needed)."
          },
          "event": [{ "listen": "test", "script": { "exec": ["pm.test('Status 200 or 404', () => pm.expect(pm.response.code).to.be.oneOf([200,404]));"] } }]
        },
        {
          "name": "Delete Bin (Device)",
          "request": {
            "method": "DELETE",
            "header": [{ "key": "Token", "value": "{{binToken}}" }],
            "url": { "raw": "{{baseUrl}}/api/SmartBin/Delete", "host": ["{{baseUrl}}"], "path": ["api","SmartBin","Delete"] },
            "description": "Delete a bin using its device token."
          },
          "event": [{ "listen": "test", "script": { "exec": ["pm.test('Status 200 or 404', () => pm.expect(pm.response.code).to.be.oneOf([200,404]));"] } }]
        }
      ]
    },

    {
      "name": "3 - Bin Sections",
      "item": [
        {
          "name": "Get Bin Sections",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{jwtToken}}" }],

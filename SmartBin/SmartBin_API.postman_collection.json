          "event": [{ "listen": "test", "script": { "exec": ["pm.test('Status 200', () => pm.response.to.have.status(200));"] } }]
        },
        {
          "name": "Get My Bin Requests",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{jwtToken}}" }],
            "url": { "raw": "{{baseUrl}}/api/BinRequest/my", "host": ["{{baseUrl}}"], "path": ["api","BinRequest","my"] },
            "description": "User gets their own bin requests."
          },
          "event": [{ "listen": "test", "script": { "exec": ["pm.test('Status 200', () => pm.response.to.have.status(200));"] } }]
        },
        {
          "name": "Accept Bin Request (Admin)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Authorization", "value": "Bearer {{jwtToken}}" }],
            "url": { "raw": "{{baseUrl}}/api/BinRequest/1/Accept", "host": ["{{baseUrl}}"], "path": ["api","BinRequest","1","Accept"] },
            "description": "Admin accepts a pending bin request — creates the bin token and assigns it."
          },
          "event": [{ "listen": "test", "script": { "exec": ["pm.test('Status 200 or 400', () => pm.expect(pm.response.code).to.be.oneOf([200,400]));"] } }]
        }
      ]
    },


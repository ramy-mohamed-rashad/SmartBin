    {
      "name": "7 - Transactions (AI Classification)",
      "item": [
        {
          "name": "Get Transactions (Paginated)",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{jwtToken}}" }],
            "url": {
              "raw": "{{baseUrl}}/api/Transaction/SmartBin/1/page/1?PageSize=10",
              "host": ["{{baseUrl}}"],
              "path": ["api","Transaction","SmartBin","1","page","1"],
              "query": [{ "key": "PageSize", "value": "10" }]
            },
            "description": "Get paginated transaction history for bin ID=1."
          },
          "event": [{ "listen": "test", "script": { "exec": ["pm.test('Status 200', () => pm.response.to.have.status(200));"] } }]
        },
        {
          "name": "Add Transaction (Device)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Token", "value": "{{binToken}}" }],
            "url": { "raw": "{{baseUrl}}/api/Transaction", "host": ["{{baseUrl}}"], "path": ["api","Transaction"] },
            "body": {
              "mode": "formdata",
              "formdata": [
                { "key": "MaterialName", "value": "Plastic", "type": "text" },
                { "key": "Image", "type": "file", "src": "" }
              ]
            },
            "description": "ESP device submits a material classification. Provide MaterialName OR Image (or both)."
          },
          "event": [{ "listen": "test", "script": { "exec": ["pm.test('Status 200 or 400', () => pm.expect(pm.response.code).to.be.oneOf([200,400]));"] } }]
        }
      ]
    },

    {
      "name": "8 - Surrounding Waste",
      "item": [
        {
          "name": "Report Surrounding Waste (AI Service → API)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "X-Camera-Token", "value": "{{cameraToken}}", "description": "Camera identification token" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "url": { "raw": "{{baseUrl}}/api/SurroundingWaste/report", "host": ["{{baseUrl}}"], "path": ["api","SurroundingWaste","report"] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"wasteLevel\": \"High\",\n  \"detectedObjectsCount\": 7,\n  \"aiConfidencePercentage\": 91.5,\n  \"imageBase64\": \"iVBORw0KGgoAAAANSUhEUgAAAAEAAAABCAYAAAAfFcSJAAAADUlEQVR42mNk+M9QDwADhgGAWjR9awAAAABJRU5ErkJggg==\",\n  \"timestamp\": \"2026-06-22T10:00:00Z\"\n}"
            },
            "description": "External AI first-hop service posts surrounding waste AI results.\n\nHeaders:\n  X-Camera-Token — identifies the camera (no JWT needed)\n\nBody (JSON):\n  wasteLevel              : Low / Medium / High\n  detectedObjectsCount    : number of waste objects\n  aiConfidencePercentage  : 0–100 float\n  imageBase64             : base64-encoded image (with or without data URI prefix)\n  timestamp               : ISO 8601 UTC timestamp"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 200 or 404', () => pm.expect(pm.response.code).to.be.oneOf([200,404]));",
                  "if (pm.response.code === 200) {",
                  "  var json = pm.response.json();",
                  "  pm.test('Message returned', () => pm.expect(json.message).to.be.a('string'));",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "Get Latest Surrounding Waste (Dashboard)",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{jwtToken}}" }],
            "url": {
              "raw": "{{baseUrl}}/api/SurroundingWaste?CameraId=1",
              "host": ["{{baseUrl}}"],
              "path": ["api","SurroundingWaste"],
              "query": [
                { "key": "CameraId", "value": "1", "description": "Use CameraId OR BinId" },
                { "key": "BinId", "value": "", "disabled": true }
              ]
            },
            "description": "Dashboard: get the most recent surrounding waste reading.\n\nQuery (provide one):\n  CameraId — filter by camera\n  BinId    — filter by bin\n\nResponse includes: id, wasteLevel, imageUrl, detectedObjectsCount, aiConfidencePercentage, timestamp, cameraId"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 200 or 404', () => pm.expect(pm.response.code).to.be.oneOf([200,404]));",
                  "if (pm.response.code === 200) {",
                  "  var json = pm.response.json();",
                  "  pm.test('Has wasteLevel', () => pm.expect(json).to.have.property('wasteLevel'));",
                  "  pm.test('Has imageUrl', () => pm.expect(json).to.have.property('imageUrl'));",
                  "  pm.test('Has detectedObjectsCount', () => pm.expect(json).to.have.property('detectedObjectsCount'));",
                  "  pm.test('Has aiConfidencePercentage', () => pm.expect(json).to.have.property('aiConfidencePercentage'));",
                  "  pm.test('Has timestamp', () => pm.expect(json).to.have.property('timestamp'));",
                  "  pm.test('Has cameraId', () => pm.expect(json).to.have.property('cameraId'));",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "Get Surrounding Waste History (Dashboard)",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{jwtToken}}" }],
            "url": {
              "raw": "{{baseUrl}}/api/SurroundingWaste/history?CameraId=1&take=20",
              "host": ["{{baseUrl}}"],
              "path": ["api","SurroundingWaste","history"],
              "query": [
                { "key": "CameraId", "value": "1", "description": "Use CameraId OR BinId" },
                { "key": "BinId", "value": "", "disabled": true },
                { "key": "take", "value": "20", "description": "Max records (default 50)" }
              ]
            },
            "description": "Dashboard: get historical surrounding waste readings, newest first.\n\nResponse is an array. Each item: id, wasteLevel, imageUrl, detectedObjectsCount, aiConfidencePercentage, timestamp, cameraId"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "pm.test('Array response', () => pm.expect(pm.response.json()).to.be.an('array'));"
                ]
              }
            }
          ]
        }
      ]
    },

    {
      "name": "9 - Crowd Density",
      "item": [
        {
          "name": "Report Crowd Density (AI Service → API)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "X-Camera-Token", "value": "{{cameraToken}}", "description": "Camera identification token" },
              { "key": "X-Bin-Token", "value": "{{binToken}}", "description": "Bin identification token (links crowd to nearby bin)" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "url": { "raw": "{{baseUrl}}/api/CrowdDensity/report", "host": ["{{baseUrl}}"], "path": ["api","CrowdDensity","report"] },
